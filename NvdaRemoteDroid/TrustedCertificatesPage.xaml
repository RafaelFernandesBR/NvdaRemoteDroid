<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NvdaRemoteDroid.ViewModels"
             xmlns:loc="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             x:Class="NvdaRemoteDroid.TrustedCertificatesPage"
             x:Name="RootPage"
             x:DataType="vm:TrustedCertificatesViewModel"
             Title="{loc:Translate TrustedCertificates_Title}">

    <VerticalStackLayout Padding="20" Spacing="12">

        <Label Text="{loc:Translate TrustedCertificates_Title}"
               SemanticProperties.HeadingLevel="Level1"
               Style="{StaticResource Headline}" />

        <Label Text="{loc:Translate TrustedCertificates_Description}" FontSize="14" />

        <Label Text="{loc:Translate TrustedCertificates_Empty}"
               IsVisible="{Binding Entries.Count, Converter={StaticResource CountToBoolConverter}, ConverterParameter=Invert}" />

        <CollectionView ItemsSource="{Binding Entries}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="vm:TrustedCertificateEntry">
                    <Grid ColumnDefinitions="*,Auto" Padding="0,8">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="{Binding HostAndPort}" FontAttributes="Bold" />
                            <Label Text="{Binding FingerprintSha256}" FontSize="12" LineBreakMode="CharacterWrap" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="{loc:Translate TrustedCertificates_Remove}"
                                Command="{Binding BindingContext.RemoveCommand, Source={x:Reference RootPage}}"
                                CommandParameter="{Binding .}"
                                AutomationProperties.Name="{loc:Translate TrustedCertificates_Remove}"
                                AutomationProperties.HelpText="{loc:Translate TrustedCertificates_Remove_Hint}" />
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </VerticalStackLayout>
</ContentPage>
