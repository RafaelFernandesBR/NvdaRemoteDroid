<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NvdaRemoteDroid.ViewModels"
             xmlns:vmcore="clr-namespace:NvdaRemoteDroid.Core.ViewModels;assembly=NvdaRemoteDroid.Core"
             xmlns:loc="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             x:Class="NvdaRemoteDroid.FavoriteKeysPage"
             x:Name="RootPage"
             x:DataType="vm:FavoriteKeysViewModel"
             Title="{loc:Translate FavoriteKeys_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="{loc:Translate FavoriteKeys_Title}"
                   SemanticProperties.HeadingLevel="Level1"
                   Style="{StaticResource Headline}" />

            <Label Text="{loc:Translate FavoriteKeys_Description}" FontSize="14" />

            <!-- Adicionar -->
            <Label Text="{loc:Translate FavoriteKeys_Add_Header}" SemanticProperties.HeadingLevel="Level2" />

            <Picker ItemsSource="{Binding Groups}"
                    SelectedItem="{Binding SelectedGroup}"
                    ItemDisplayBinding="{Binding Title}"
                    Title="{loc:Translate FavoriteKeys_Group_Picker_Title}"
                    MinimumHeightRequest="48"
                    AutomationProperties.Name="{loc:Translate FavoriteKeys_Group_Picker_Name}"
                    SemanticProperties.Description="{loc:Translate FavoriteKeys_Group_Picker_Name}" />

            <Picker ItemsSource="{Binding Keys}"
                    SelectedItem="{Binding SelectedKey}"
                    ItemDisplayBinding="{Binding Name}"
                    Title="{loc:Translate FavoriteKeys_Key_Picker_Title}"
                    MinimumHeightRequest="48"
                    AutomationProperties.Name="{loc:Translate FavoriteKeys_Key_Picker_Name}"
                    SemanticProperties.Description="{loc:Translate FavoriteKeys_Key_Picker_Name}" />

            <Label Text="{loc:Translate FavoriteKeys_Modifiers_Header}" SemanticProperties.HeadingLevel="Level2" />

            <HorizontalStackLayout Spacing="8">
                <Switch IsToggled="{Binding UseCtrl}"
                        SemanticProperties.Description="{loc:Translate RemoteControl_ModifierCtrl}"
                        SemanticProperties.Hint="{loc:Translate FavoriteKeys_Modifier_Hint}"
                        AutomationProperties.Name="{loc:Translate RemoteControl_ModifierCtrl}"
                        AutomationProperties.HelpText="{loc:Translate FavoriteKeys_Modifier_Hint}" />
                <Label Text="{loc:Translate RemoteControl_ModifierCtrl}" VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <Switch IsToggled="{Binding UseAlt}"
                        SemanticProperties.Description="{loc:Translate RemoteControl_ModifierAlt}"
                        SemanticProperties.Hint="{loc:Translate FavoriteKeys_Modifier_Hint}"
                        AutomationProperties.Name="{loc:Translate RemoteControl_ModifierAlt}"
                        AutomationProperties.HelpText="{loc:Translate FavoriteKeys_Modifier_Hint}" />
                <Label Text="{loc:Translate RemoteControl_ModifierAlt}" VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <Switch IsToggled="{Binding UseShift}"
                        SemanticProperties.Description="{loc:Translate RemoteControl_ModifierShift}"
                        SemanticProperties.Hint="{loc:Translate FavoriteKeys_Modifier_Hint}"
                        AutomationProperties.Name="{loc:Translate RemoteControl_ModifierShift}"
                        AutomationProperties.HelpText="{loc:Translate FavoriteKeys_Modifier_Hint}" />
                <Label Text="{loc:Translate RemoteControl_ModifierShift}" VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <Switch IsToggled="{Binding UseWin}"
                        SemanticProperties.Description="{loc:Translate RemoteControl_ModifierWin}"
                        SemanticProperties.Hint="{loc:Translate FavoriteKeys_Modifier_Hint}"
                        AutomationProperties.Name="{loc:Translate RemoteControl_ModifierWin}"
                        AutomationProperties.HelpText="{loc:Translate FavoriteKeys_Modifier_Hint}" />
                <Label Text="{loc:Translate RemoteControl_ModifierWin}" VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="8">
                <Switch IsToggled="{Binding UseNvda}"
                        SemanticProperties.Description="{loc:Translate RemoteControl_NvdaKey}"
                        SemanticProperties.Hint="{loc:Translate FavoriteKeys_Modifier_Hint}"
                        AutomationProperties.Name="{loc:Translate RemoteControl_NvdaKey}"
                        AutomationProperties.HelpText="{loc:Translate FavoriteKeys_Modifier_Hint}" />
                <Label Text="{loc:Translate RemoteControl_NvdaKey}" VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False" />
            </HorizontalStackLayout>

            <Button Text="{loc:Translate FavoriteKeys_Add}"
                    Command="{Binding AddCommand}"
                    MinimumHeightRequest="48"
                    AutomationProperties.Name="{loc:Translate FavoriteKeys_Add}"
                    AutomationProperties.HelpText="{loc:Translate FavoriteKeys_Add_Hint}" />

            <BoxView HeightRequest="1" AutomationProperties.IsInAccessibleTree="False" />

            <!-- Lista -->
            <Label Text="{loc:Translate FavoriteKeys_List_Header}" SemanticProperties.HeadingLevel="Level2" />

            <Label Text="{loc:Translate FavoriteKeys_Empty}"
                   IsVisible="{Binding Entries.Count, Converter={StaticResource CountToBoolConverter}, ConverterParameter=Invert}" />

            <!-- BindableLayout (e não CollectionView): a lista já está dentro de um ScrollView. -->
            <VerticalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Entries}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vmcore:FavoriteEntry">
                        <VerticalStackLayout Spacing="6" Padding="0,8">
                            <Label Text="{Binding Name}" FontAttributes="Bold" />
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <Button Grid.Column="0"
                                        Text="{loc:Translate FavoriteKeys_MoveUp}"
                                        Command="{Binding BindingContext.MoveUpCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}"
                                        IsEnabled="{Binding IsFirst, Converter={StaticResource InvertedBoolConverter}}"
                                        MinimumHeightRequest="48"
                                        Padding="4,10"
                                        AutomationProperties.Name="{Binding MoveUpName}"
                                        SemanticProperties.Description="{Binding MoveUpName}" />
                                <Button Grid.Column="1"
                                        Text="{loc:Translate FavoriteKeys_MoveDown}"
                                        Command="{Binding BindingContext.MoveDownCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}"
                                        IsEnabled="{Binding IsLast, Converter={StaticResource InvertedBoolConverter}}"
                                        MinimumHeightRequest="48"
                                        Padding="4,10"
                                        AutomationProperties.Name="{Binding MoveDownName}"
                                        SemanticProperties.Description="{Binding MoveDownName}" />
                                <Button Grid.Column="2"
                                        Text="{loc:Translate FavoriteKeys_Remove}"
                                        Command="{Binding BindingContext.RemoveCommand, Source={x:Reference RootPage}}"
                                        CommandParameter="{Binding .}"
                                        MinimumHeightRequest="48"
                                        Padding="4,10"
                                        AutomationProperties.Name="{Binding RemoveName}"
                                        SemanticProperties.Description="{Binding RemoveName}" />
                            </Grid>
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
