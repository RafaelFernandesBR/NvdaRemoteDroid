<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NvdaRemoteDroid.ViewModels"
             xmlns:controls="clr-namespace:NvdaRemoteDroid.Controls"
             xmlns:loc="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             x:Class="NvdaRemoteDroid.RemoteControlPage"
             x:DataType="vm:RemoteControlViewModel"
             Title="{loc:Translate RemoteControl_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label Text="{Binding StatusText}"
                   SemanticProperties.Hint="{loc:Translate Connection_Status_Label}" />

            <!-- Sem conexão: explica e leva à aba Conexão, em vez de mostrar um teclado desabilitado. -->
            <VerticalStackLayout Spacing="12"
                                 IsVisible="{Binding IsConnected, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{loc:Translate RemoteControl_NotConnected}" />
                <Button Text="{loc:Translate RemoteControl_GoToConnection}"
                        Command="{Binding GoToConnectionCommand}"
                        AutomationProperties.Name="{loc:Translate RemoteControl_GoToConnection}"
                        AutomationProperties.HelpText="{loc:Translate RemoteControl_GoToConnection_Hint}" />
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsConnected}">

                <controls:VirtualKeyboardView x:Name="Keyboard" />

                <Label Text="{loc:Translate RemoteControl_TypeText_Title}"
                       SemanticProperties.HeadingLevel="Level2" />
                <Entry Text="{Binding TextToSend}"
                       Placeholder="{loc:Translate RemoteControl_TypeText_Placeholder}"
                       ReturnCommand="{Binding SendTextCommand}"
                       ReturnType="Send"
                       AutomationProperties.Name="{loc:Translate RemoteControl_TypeText_Title}" />
                <Button Text="{loc:Translate RemoteControl_SendText}"
                        Command="{Binding SendTextCommand}"
                        AutomationProperties.Name="{loc:Translate RemoteControl_SendText}"
                        AutomationProperties.HelpText="{loc:Translate RemoteControl_SendText_Hint}" />

                <Label Text="{loc:Translate RemoteControl_Actions_Title}"
                       SemanticProperties.HeadingLevel="Level2" />
                <Button Text="{loc:Translate RemoteControl_SendClipboard}"
                        Command="{Binding SendClipboardCommand}"
                        AutomationProperties.Name="{loc:Translate RemoteControl_SendClipboard}"
                        AutomationProperties.HelpText="{loc:Translate RemoteControl_SendClipboard_Hint}" />
                <Button Text="{loc:Translate RemoteControl_SendSas}"
                        Command="{Binding SendSasCommand}"
                        AutomationProperties.Name="{loc:Translate RemoteControl_SendSas}"
                        AutomationProperties.HelpText="{loc:Translate RemoteControl_SendSas_Hint}" />
                <Button Text="{loc:Translate RemoteControl_Disconnect}"
                        Command="{Binding DisconnectCommand}"
                        AutomationProperties.Name="{loc:Translate RemoteControl_Disconnect}"
                        AutomationProperties.HelpText="{loc:Translate RemoteControl_Disconnect_Hint}" />

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
