<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NvdaRemoteDroid.ViewModels"
             xmlns:gateway="clr-namespace:NvdaRemoteDroid.Core.Gateway;assembly=NvdaRemoteDroid.Core"
             xmlns:loc="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             x:Class="NvdaRemoteDroid.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{loc:Translate Settings_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{loc:Translate Settings_Title}"
                   SemanticProperties.HeadingLevel="Level1"
                   Style="{StaticResource Headline}" />

            <Label Text="{loc:Translate Settings_Description}" FontSize="14" />

            <Label Text="{loc:Translate Settings_NvdaKey_Label}" SemanticProperties.HeadingLevel="Level2" />

            <RadioButton Content="{loc:Translate Settings_NvdaKey_Insert}"
                         GroupName="NvdaKey"
                         IsChecked="{Binding NvdaKey, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Insert}"
                         AutomationProperties.Name="{loc:Translate Settings_NvdaKey_Insert}" />

            <RadioButton Content="{loc:Translate Settings_NvdaKey_CapsLock}"
                         GroupName="NvdaKey"
                         IsChecked="{Binding NvdaKey, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CapsLock}"
                         AutomationProperties.Name="{loc:Translate Settings_NvdaKey_CapsLock}" />

            <Button Text="{loc:Translate Settings_TrustedCertificates}"
                    Clicked="OnTrustedCertificatesClicked"
                    AutomationProperties.Name="{loc:Translate Settings_TrustedCertificates}"
                    AutomationProperties.HelpText="{loc:Translate Settings_TrustedCertificates_Hint}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
