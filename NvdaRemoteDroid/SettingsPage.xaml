<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:NvdaRemoteDroid.ViewModels"
             xmlns:gateway="clr-namespace:NvdaRemoteDroid.Core.Gateway;assembly=NvdaRemoteDroid.Core"
             xmlns:loc="clr-namespace:LocalizationResourceManager.Maui;assembly=LocalizationResourceManager.Maui"
             x:Class="NvdaRemoteDroid.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{loc:Translate Settings_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Label Text="{loc:Translate Settings_Title}"
                   SemanticProperties.HeadingLevel="Level1"
                   Style="{StaticResource Headline}" />

            <Label Text="{loc:Translate Settings_Description}" FontSize="14" />

            <Label Text="{loc:Translate Settings_NvdaKey_Label}" SemanticProperties.HeadingLevel="Level2" />

            <RadioButton Content="{loc:Translate Settings_NvdaKey_Insert}"
                         GroupName="NvdaKey"
                         IsChecked="{Binding NvdaKey, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=Insert}"
                         AutomationProperties.Name="{loc:Translate Settings_NvdaKey_Insert}" />

            <RadioButton Content="{loc:Translate Settings_NvdaKey_CapsLock}"
                         GroupName="NvdaKey"
                         IsChecked="{Binding NvdaKey, Converter={StaticResource EnumToBoolConverter}, ConverterParameter=CapsLock}"
                         AutomationProperties.Name="{loc:Translate Settings_NvdaKey_CapsLock}" />

            <Button Text="{loc:Translate Settings_FavoriteKeys}"
                    Clicked="OnFavoriteKeysClicked"
                    MinimumHeightRequest="48"
                    AutomationProperties.Name="{loc:Translate Settings_FavoriteKeys}"
                    AutomationProperties.HelpText="{loc:Translate Settings_FavoriteKeys_Hint}" />

            <Button Text="{loc:Translate Settings_TrustedCertificates}"
                    Clicked="OnTrustedCertificatesClicked"
                    AutomationProperties.Name="{loc:Translate Settings_TrustedCertificates}"
                    AutomationProperties.HelpText="{loc:Translate Settings_TrustedCertificates_Hint}" />

            <BoxView HeightRequest="1" AutomationProperties.IsInAccessibleTree="False" />

            <Label Text="{loc:Translate Settings_Voice_Header}" SemanticProperties.HeadingLevel="Level2" />

            <Label Text="{loc:Translate Settings_Voice_Description}" FontSize="14" />

            <Picker ItemsSource="{Binding Engines}"
                    SelectedItem="{Binding SelectedEngine}"
                    ItemDisplayBinding="{Binding Display}"
                    Title="{loc:Translate Settings_Voice_PickerTitle}"
                    MinimumHeightRequest="48"
                    AutomationProperties.Name="{loc:Translate Settings_Voice_Picker_Name}"
                    AutomationProperties.HelpText="{loc:Translate Settings_Voice_Picker_Help}" />

            <Label Text="{Binding SpeechRateLabel}" />

            <Slider Minimum="0.5"
                    Maximum="2.0"
                    Value="{Binding SpeechRate}"
                    MinimumHeightRequest="44"
                    AutomationProperties.Name="{loc:Translate Settings_SpeechRate_Name}"
                    AutomationProperties.HelpText="{loc:Translate Settings_SpeechRate_Help}" />

            <Button Text="{loc:Translate Settings_Voice_Test}"
                    Command="{Binding TestVoiceCommand}"
                    MinimumHeightRequest="44"
                    AutomationProperties.Name="{loc:Translate Settings_Voice_Test}"
                    AutomationProperties.HelpText="{loc:Translate Settings_Voice_Test_Help}" />

            <BoxView HeightRequest="1" AutomationProperties.IsInAccessibleTree="False" />

            <Label Text="{loc:Translate Settings_ShareLogs_Description}" />

            <Button Text="{loc:Translate Settings_ShareLogs}"
                    Command="{Binding ShareLogsCommand}"
                    AutomationProperties.Name="{loc:Translate Settings_ShareLogs}"
                    AutomationProperties.HelpText="{loc:Translate Settings_ShareLogs_Hint}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
